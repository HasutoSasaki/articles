<mxCell id="slackgrp" value="Slack（プライベートチャンネル #service-alert）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F4FB;strokeColor=#4A154B;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontColor=#4A154B;" vertex="1" parent="1"><mxGeometry x="30" y="40" width="300" height="440" as="geometry"/></mxCell>
